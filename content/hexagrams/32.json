{
  "id": 32,
  "statement": {
    "id": "h32-statement",
    "original": "恒：亨，无咎，利貞。利有攸往。",
    "notes": [],
    "originalRefs": [
      {
        "sourceId": "skqs-zhouyi-6-batch4",
        "locator": "卷6 / 恒 / 卦辞 / 0007冊.djvu/429"
