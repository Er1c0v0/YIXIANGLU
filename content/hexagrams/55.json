        "reviewId": "review-h55-image-5"
      }
    },
    {
      "position": 6,
      "polarity": 0,
      "label": "上六",
      "text": {
        "id": "h55-yao-6",
        "original": "豐其屋，蔀其家，闚其戸，闃其无人，三嵗不覿，凶。",
        "notes": [
