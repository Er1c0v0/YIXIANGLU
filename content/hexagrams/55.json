        ],
        "reviewId": "review-h55-yao-5"
      },
      "smallImage": {
        "id": "h55-image-5",
        "original": "六五之吉，有慶也。",
        "notes": [],
        "originalRefs": [
          {
            "sourceId": "skqs-zhouyi-9-batch6",
            "locator": "卷9 / 豐 / 六五小象 / 0007冊.djvu/498"
