      "position": 1,
      "polarity": 1,
      "label": "初九",
      "text": {
        "id": "h55-yao-1",
        "original": "遇其配主，雖旬无咎，徃有尚。",
        "notes": [
          "采用电子录文“徃”，普通电子对校页相应为“往”；保留所见，影印字形与异文待核。"
        ],
        "originalRefs": [
          {
            "sourceId": "skqs-zhouyi-9-batch6",
            "locator": "卷9 / 豐 / 初九 / 0007冊.djvu/496"
          }
        ],
        "reviewId": "review-h55-yao-1"
      },
      "smallImage": {
        "id": "h55-image-1",
        "original": "雖旬无咎，過旬災也。",
        "notes": [],
        "originalRefs": [
          {
            "sourceId": "skqs-zhouyi-9-batch6",
            "locator": "卷9 / 豐 / 初九小象 / 0007冊.djvu/496–497"
