{
  "id": 38,
  "statement": {
    "id": "h38-statement",
    "original": "睽：小事吉。",
    "notes": [],
    "originalRefs": [
      {
        "sourceId": "skqs-zhouyi-7-batch5",
        "locator": "卷7 / 睽 / 卦辞 / 0007册.djvu/444"
