  "tuan": {
    "id": "h27-tuan",
    "original": "頤貞吉，養正則吉也。觀頤，觀其所養也。自求口實，觀其自養也。天地養萬物，聖人養賢以及萬民。頤之時大矣哉。",
    "notes": [],
    "originalRefs": [
      {
        "sourceId": "skqs-zhouyi-5-batch4",
        "locator": "卷5 / 頤 / 彖曰 / 0007冊.djvu/411"
      }
    ],
    "reviewId": "review-h27-tuan"
  },
  "greatImage": {
    "id": "h27-great-image",
    "original": "山下有雷，頤；君子以慎言語，節飲食。",
    "notes": [],
