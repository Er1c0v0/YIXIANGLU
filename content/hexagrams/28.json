    ],
    "reviewId": "review-h28-statement"
  },
  "tuan": {
    "id": "h28-tuan",
    "original": "大過，大者過也。棟橈，本末弱也。剛過而中，巽而說行，利有攸往，乃亨。大過之時大矣哉。",
    "notes": [],
    "originalRefs": [
      {
        "sourceId": "skqs-zhouyi-5-batch4",
        "locator": "卷5 / 大過 / 彖曰 / 0007冊.djvu/414"
      }
    ],
    "reviewId": "review-h28-tuan"
  },
  "greatImage": {
    "id": "h28-great-image",
    "original": "澤滅木，大過；君子以獨立不懼，遯世无悶。",
    "notes": [],
    "originalRefs": [
      {
