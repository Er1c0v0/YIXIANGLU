  "statement": {
    "id": "h28-statement",
    "original": "大過：棟橈，利有攸往，亨。",
    "notes": [
      "卦名后的“音相過之過”是音义注文，未并入卦辞。"
    ],
    "originalRefs": [
      {
        "sourceId": "skqs-zhouyi-5-batch4",
        "locator": "卷5 / 大過 / 卦辞 / 0007冊.djvu/413"
