    "reviewId": "review-h28-statement"
  },
  "tuan": {
    "id": "h28-tuan",
    "original": "大过，大者过也。栋桡，本末弱也。刚过而中，巽而说行，利有攸往，乃亨。大过之时大矣哉。",
    "notes": [],
    "originalRefs": [
      {
        "sourceId": "skqs-zhouyi-5-batch4",
        "locator": "卷5 / 大过 / 彖曰 / 0007册.djvu/414"
      }
    ],
    "reviewId": "review-h28-tuan"
  },
  "greatImage": {
