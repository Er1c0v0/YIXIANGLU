        ],
        "reviewId": "review-h56-yao-3"
      },
      "smallImage": {
        "id": "h56-image-3",
        "original": "旅焚其次，亦以伤矣。以旅与下，其义丧也。",
        "notes": [],
        "originalRefs": [
          {
            "sourceId": "skqs-zhouyi-9-batch6",
            "locator": "卷9 / 旅 / 九三小象 / 0007册.djvu/500"
