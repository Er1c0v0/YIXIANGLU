    {
      "position": 3,
      "polarity": 1,
      "label": "九三",
      "text": {
        "id": "h56-yao-3",
        "original": "旅焚其次，丧其童仆，贞厉。",
        "notes": [
          "采用电子录文“童”，普通电子对校页相应为“僮”；保留所见，影印字形与异文待核。"
        ],
        "originalRefs": [
          {
            "sourceId": "skqs-zhouyi-9-batch6",
            "locator": "卷9 / 旅 / 九三 / 0007册.djvu/500"
