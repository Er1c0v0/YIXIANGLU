  "tuan": {
    "id": "h54-tuan",
    "original": "归妹，天地之大义也。天地不交而万物不兴，归妹，人之终始也。说以动，所归妹也。征凶，位不当也。无攸利，柔乗刚也。",
    "notes": [
      "采用电子录文“説”，普通电子对校页相应为“說”；采用电子录文“乗”，普通电子对校页相应为“乘”；保留所见，影印字形与异文待核。"
    ],
    "originalRefs": [
      {
        "sourceId": "skqs-zhouyi-9-batch6",
        "locator": "卷9 / 归妹 / 彖曰 / 0007册.djvu/493"
      }
    ],
    "reviewId": "review-h54-tuan"
  },
  "greatImage": {
    "id": "h54-great-image",
    "original": "泽上有雷，归妹；君子以永终知敝。",
    "notes": [],
    "originalRefs": [
      {
        "sourceId": "skqs-zhouyi-9-batch6",
        "locator": "卷9 / 归妹 / 整卦大象 / 0007册.djvu/494"
      }
    ],
    "reviewId": "review-h54-great-image"
  },
  "summary": "泽上有雷，知敝慎终。",
  "overallMeaning": "归妹以婚嫁关系呈现位置、时机与责任的问题。关系的建立需要适当的条件，不能仅凭一时喜悦推进；还应从长久相处着眼，预见可能的弊端。",
  "imagery": [
    "兑下震上，悦而动。",
    "泽上有雷，永终知敝。"
  ],
