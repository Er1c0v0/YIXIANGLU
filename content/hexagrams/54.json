{
  "id": 54,
  "statement": {
    "id": "h54-statement",
    "original": "归妹：征凶，无攸利。",
    "notes": [],
    "originalRefs": [
      {
        "sourceId": "skqs-zhouyi-9-batch6",
        "locator": "卷9 / 归妹 / 卦辞 / 0007册.djvu/493"
