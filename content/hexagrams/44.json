  "tuan": {
    "id": "h44-tuan",
    "original": "姤，遇也，柔遇剛也。勿用取女，不可與長也。天地相遇，品物咸章也。剛遇中正，天下大行也。姤之時義大矣哉！",
    "notes": [],
    "originalRefs": [
      {
        "sourceId": "skqs-zhouyi-8",
        "locator": "卷8 / 姤 / 彖曰 / 0007冊.djvu/463"
      }
    ],
    "reviewId": "review-h44-tuan"
  },
  "greatImage": {
    "id": "h44-great-image",
    "original": "天下有風，姤；后以施命誥四方。",
    "notes": [],
