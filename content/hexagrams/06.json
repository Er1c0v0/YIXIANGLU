  "tuan": {
    "id": "h6-tuan",
    "original": "讼，上刚下险，险而健，讼。讼有孚，窒，惕，中吉，刚来而得中也。终凶，讼不可成也。利见大人，尚中正也。不利涉大川，入于渊也。",
    "notes": [],
    "originalRefs": [
      {
        "sourceId": "skqs-zhouyi-2-batch2",
        "locator": "卷2 / 讼 / 彖曰 / 0007册.djvu/347–348"
      }
    ],
    "reviewId": "review-h6-tuan"
  },
  "greatImage": {
