      "position": 1,
      "polarity": 0,
      "label": "初六",
      "text": {
        "id": "h53-yao-1",
        "original": "鸿渐于干，小子厉，有言，无咎。",
        "notes": [],
        "originalRefs": [
          {
            "sourceId": "skqs-zhouyi-9-batch6",
            "locator": "卷9 / 渐 / 初六 / 0007册.djvu/491"
