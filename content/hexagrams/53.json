        "reviewId": "review-h53-yao-1"
      },
      "smallImage": {
        "id": "h53-image-1",
        "original": "小子之厉，义无咎也。",
        "notes": [],
        "originalRefs": [
          {
            "sourceId": "skqs-zhouyi-9-batch6",
            "locator": "卷9 / 渐 / 初六小象 / 0007册.djvu/491"
          }
