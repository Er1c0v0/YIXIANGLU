{
  "id": 22,
  "statement": {
    "id": "h22-statement",
    "original": "賁：亨，小利有攸徃。",
    "notes": [],
    "originalRefs": [
      {
        "sourceId": "skqs-zhouyi-4-batch4",
        "locator": "卷4 / 賁 / 卦辞 / 0007冊.djvu/395"
