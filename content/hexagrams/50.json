{
  "id": 50,
  "statement": {
    "id": "h50-statement",
    "original": "鼎：元吉，亨。",
    "notes": [],
    "originalRefs": [
      {
        "sourceId": "skqs-zhouyi-8-batch6",
        "locator": "卷8 / 鼎 / 卦辞 / 0007冊.djvu/478"
