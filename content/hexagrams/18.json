  "tuan": {
    "id": "h18-tuan",
    "original": "蠱，剛上而柔下，巽而止，蠱。蠱元亨，而天下治也。利涉大川，徃有事也。先甲三日，後甲三日，終則有始，天行也。",
    "notes": [],
    "originalRefs": [
      {
        "sourceId": "skqs-zhouyi-4-batch3",
        "locator": "卷4 / 蠱 / 彖曰 / 0007冊.djvu/386"
      }
    ],
    "reviewId": "review-h18-tuan"
  },
  "greatImage": {
    "id": "h18-great-image",
    "original": "山下有風，蠱；君子以振民育徳。",
