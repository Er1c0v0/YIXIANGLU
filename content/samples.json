  {
    "id": 1,
    "statement": {
      "id": "h1-statement",
      "original": "乾：元亨。利貞。",
      "explanation": "开创而亨通，利于守持正道。这里按《易传》的德性解释理解“元亨利贞”。",
      "notes": [],
      "originalRefs": [
        {
          "sourceId": "ws-zhouyi-1",
          "locator": "第1卦 乾 / 易經 / 卦辞"
        }
      ],
      "explanationRefs": [
        {
          "sourceId": "ws-zhouyi-1",
          "locator": "第1卦 乾 / 易經 / 卦辞"
        }
      ],
      "reviewId": "review-h1-statement"
    },
    "tuan": {
      "id": "h1-tuan",
      "original": "大哉乾元，萬物資始，乃統天。雲行雨施，品物流形，大明終始，六位時成。時乘六龍以御天，乾道變化，各正性命，保合大和，乃利貞。首出庶物，萬國咸寧。",
      "explanation": "乾的创始作用使万物开始生长，并统贯天道。云行雨降，万物形成各自的形态；明察终始，六爻随时序呈现。借六龙说明顺时而动，使万物各安其性命、保持和谐，进而守正。作为万物的先导，天下由此安宁。",
      "notes": [],
      "originalRefs": [
        {
          "sourceId": "ws-zhouyi-1",
          "locator": "第1卦 乾 / 彖曰 / 全段"
        }
      ],
      "explanationRefs": [
        {
          "sourceId": "ws-zhouyi-1",
          "locator": "第1卦 乾 / 彖曰 / 全段"
        }
      ],
      "reviewId": "review-h1-tuan"
    },
    "greatImage": {
      "id": "h1-great-image",
