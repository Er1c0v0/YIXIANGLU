page { background: #F7F4ED; color: #292824; font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif; font-size: 0.9375rem; line-height: 1.7; }
view, button, input { box-sizing: border-box; }
.page { padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); }
.eyebrow { font-size: 0.75rem; letter-spacing: 4rpx; color: #765535; margin-bottom: 12rpx; }
.title { font-size: 1.375rem; font-weight: 600; line-height: 1.4; margin-bottom: 16rpx; }
.subtitle, .muted { color: #625D55; }
.subtitle { margin-bottom: 28rpx; }
.card { background: #FFFDFA; border: 1rpx solid #DDD6C9; border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; }
.section-title { font-size: 1.0625rem; font-weight: 600; margin-bottom: 16rpx; }
.label { display: block; font-size: 0.78125rem; color: #765535; margin-bottom: 10rpx; }
.original { display: block; font-size: 1.0625rem; line-height: 1.85; margin-bottom: 22rpx; white-space: pre-wrap; }
.notes { font-size: 0.8125rem; color: #625D55; margin-top: 16rpx; }
button { display: block; width: 100%; font-size: 0.9375rem; font-weight: 500; border-radius: 14rpx; margin: 16rpx 0 0; min-height: 48px; line-height: 48px; padding: 0 20rpx; background: #EDE7DA; color: #292824; }
button::after { border: none; }
.button-pressed { opacity: 0.65; }
button.primary { background: #765535; color: #FFFDFA; }
button.primary[disabled], button[disabled]:not([size='mini']) { background: #E8E2D7; color: #81796D; }
button.link { background: transparent; color: #765535; }
.row { display: flex; align-items: center; gap: 24rpx; }
.between { justify-content: space-between; }
.notice { padding: 22rpx 26rpx; background: #EFE9DE; color: #625D55; border-radius: 14rpx; font-size: 0.84375rem; margin: 20rpx 0; }
.error { color: #A83B32; font-size: 0.8125rem; margin-top: 8rpx; }
.empty { padding: 64rpx 28rpx; text-align: center; }
input { background: #F7F4ED; border: 1rpx solid #DDD6C9; border-radius: 12rpx; padding: 20rpx; height: 100rpx; min-height: 48px; width: 100%; font-size: 1rem; }
.rule { border-top: 1rpx solid #DDD6C9; margin: 28rpx 0; }

button:not([size='mini']) { width: 100%; }
