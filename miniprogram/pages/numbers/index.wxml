<view class="page">
  <view class="title">数字起卦</view>
  <view wx:for="{{fields}}" wx:key="label" class="card">
    <view class="section-title">{{item.label}}</view>
    <input class="number-input" type="number" maxlength="{{-1}}" value="{{item.value}}" data-index="{{index}}" bindinput="input" bindfocus="focus" bindblur="blur" placeholder="请输入正整数" placeholder-style="{{focusedIndex === index ? 'color: #B6AEA1' : 'color: #8A8276'}}" aria-label="{{item.label}}" adjust-position cursor-spacing="32" />
    <view wx:if="{{item.error}}" class="error">{{item.error}}</view>
  </view>
  <button class="primary" bindtap="generate" disabled="{{!valid}}" hover-class="button-pressed" hover-stay-time="80">生成本卦</button>
</view>
