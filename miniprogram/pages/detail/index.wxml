<view class="page">
  <block wx:if="{{valid}}">
    <reading hexagram-id="{{id}}" show-yao="{{true}}" />
    <button class="primary" bindtap="observe" hover-class="button-pressed" hover-stay-time="80">观察变化</button>
    <button wx:if="{{showAtlasLink}}" class="link" bindtap="atlas" hover-class="button-pressed" hover-stay-time="80">返回图鉴</button>
  </block>
  <view wx:else class="card empty">
    <view class="section-title">未找到该卦</view>
    <button class="primary" bindtap="atlas" hover-class="button-pressed" hover-stay-time="80">返回图鉴</button>
  </view>
</view>
