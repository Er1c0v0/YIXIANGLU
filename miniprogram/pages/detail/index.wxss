.directory-bar { position: sticky; top: 0; z-index: 1; background: #F7F4ED; padding: 12rpx 0; margin-bottom: 24rpx; }
.directory-trigger { display: flex; justify-content: space-between; margin: 0; background: #FFFDFA; border: 1rpx solid #DDD6C9; text-align: left; }
.reading-navigation { display: flex; align-items: stretch; gap: 20rpx; }
.reading-navigation button { flex: 1; min-width: 0; margin: 0; padding: 18rpx 12rpx; line-height: 1.7; }
.reading-navigation text { display: block; }
.directory-sheet { background: #F7F4ED; padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); }
.directory-header { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.directory-header .section-title { margin: 0; }
.directory-header button { width: auto; margin: 0; flex-shrink: 0; }
.directory-items { height: 60vh; }
.directory-item { margin: 0; text-align: left; background: transparent; border-radius: 0; border-bottom: 1rpx solid #DDD6C9; padding: 14rpx 0; line-height: 1.7; }
.directory-yao { display: flex; flex-wrap: wrap; padding: 12rpx 0; }
.directory-yao button { flex: 0 0 33.333%; width: auto; margin: 0; padding: 8rpx; line-height: 1.7; }
