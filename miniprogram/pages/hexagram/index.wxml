  <block wx:if="{{valid}}"><view class="eyebrow">第二步 · 先读本卦</view><reading hexagram-id="{{id}}" /><button class="primary" bindtap="next" disabled="{{busy}}">{{numberMode ? '查看固定变爻' : '选择变爻'}}</button></block>
