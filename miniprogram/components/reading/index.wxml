<block wx:if="{{meta}}">
  <view class="card heading">
    <view class="row between"><view><view class="eyebrow">第 {{meta.id}} 卦</view><view class="title">{{meta.fullName}}</view><view class="muted">上卦 · {{upperName}}　下卦 · {{lowerName}}</view></view><hexagram-shape lines="{{meta.lines}}" /></view>
    <view wx:if="{{content}}" class="summary">{{content.summary}}</view>
  </view>
  <view wx:if="{{!content}}" class="card empty"><view class="section-title">资料整理中</view></view>
  <block wx:else>
    <view class="card">
      <button class="disclosure" bindtap="toggleStatement" aria-expanded="{{statementOpen}}" hover-class="button-pressed" hover-stay-time="80">卦辞 <text>{{statementOpen ? '−' : '＋'}}</text></button>
      <view wx:if="{{statementOpen}}"><view class="original" selectable>{{content.statement.original}}</view><source-panel refs="{{content.statement.originalRefs}}" /></view>
    </view>
    <view class="card">
      <button class="disclosure" bindtap="toggleOverview" aria-expanded="{{overviewOpen}}" hover-class="button-pressed" hover-stay-time="80">意象与整体含义 <text>{{overviewOpen ? '−' : '＋'}}</text></button>
      <view wx:if="{{overviewOpen}}"><view wx:for="{{content.imagery}}" wx:key="*this" class="imagery">{{item}}</view><view class="overall">{{content.overallMeaning}}</view><source-panel refs="{{content.overviewRefs}}" /></view>
    </view>
    <view class="card"><button class="disclosure" bindtap="toggleTuan" aria-expanded="{{tuanOpen}}" hover-class="button-pressed" hover-stay-time="80">彖传 <text>{{tuanOpen ? '−' : '＋'}}</text></button><view wx:if="{{tuanOpen}}"><view class="original" selectable>{{content.tuan.original}}</view><source-panel refs="{{content.tuan.originalRefs}}" /></view></view>
    <view class="card"><button class="disclosure" bindtap="toggleImage" aria-expanded="{{imageOpen}}" hover-class="button-pressed" hover-stay-time="80">大象传 <text>{{imageOpen ? '−' : '＋'}}</text></button><view wx:if="{{imageOpen}}"><view class="original" selectable>{{content.greatImage.original}}</view><source-panel refs="{{content.greatImage.originalRefs}}" /></view></view>
    <view wx:if="{{content.specialEntries.length}}" class="card"><button class="disclosure" bindtap="toggleSpecial" aria-expanded="{{specialOpen}}" hover-class="button-pressed" hover-stay-time="80">{{meta.id === 1 ? '用九' : '用六'}} <text>{{specialOpen ? '−' : '＋'}}</text></button><view wx:if="{{specialOpen}}" wx:for="{{content.specialEntries}}" wx:key="kind"><view class="original" selectable>{{item.text.original}}</view><text class="label space">相关象传</text><view class="original" selectable>{{item.smallImage.original}}</view><source-panel refs="{{item.text.originalRefs}}" /></view></view>
  </block>
</block>
